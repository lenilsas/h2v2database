<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>h2-patch-v2</groupId>
    <artifactId>h2v2-build</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>


    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
             
<!-- renovate: datasource=github-tags depName=h2database/h2database extractVersion=^version-(?<version>.*)$ -->
        <h2.version>2.5.250</h2.version>
        <h2.tag>version-${h2.version}</h2.tag>
    </properties>

    <build>
        <!-- final artifact name -->
        <finalName>h2v2-${h2.version}</finalName>

        <plugins>

            <!-- 1) H2 per git laden, patchen (jdbc:h2: zu jdbc:h2v2:) und bauen -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>

                <executions>
                    <execution>
                        <id>build-patched-h2</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument><![CDATA[
set -eu

SRC="$PWD/target/h2-src"

echo "=== H2-Quellcode herunterladen ==="
rm -rf "$SRC"
git clone --depth 1 --branch "${h2.tag}" https://github.com/h2database/h2database.git "$SRC"
cd "$SRC/h2"

echo "=== JDBC-URL-Präfix im Quellcode ändern ==="
grep -rlZ --include='*.java' 'jdbc:h2:' src/main \
  | xargs -0 -r sed -i 's/jdbc:h2:/jdbc:h2v2:/g'

echo "=== MVStore-Klassennamen patchen ==="
META="$SRC/h2/src/main/org/h2/mvstore/type/MetaType.java"
sed -i \
  's/String className = clazz.getName();/String className = clazz.getName().replace(String.join("h","org.","2v2."), String.join("h","org.","2."));/' \
  "$META"

sed -i \
  's/Class<?> clazz = Class.forName(className);/Class<?> clazz = Class.forName(className.replace(String.join("h","org.","2."), String.join("h","org.","2v2.")));/' \
  "$META"

echo "=== Kontrolle des Patches ==="
grep -F 'String className = clazz.getName().replace(String.join("h","org.","2v2."), String.join("h","org.","2."));' "$META"
grep -F 'Class<?> clazz = Class.forName(className.replace(String.join("h","org.","2."), String.join("h","org.","2v2.")));' "$META"

echo "=== H2 bauen ==="
export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
export PATH="$JAVA_HOME/bin:$PATH"
bash ./build.sh jar

JAR="$SRC/h2/bin/h2-${h2.version}.jar"
test -f "$JAR" || {
  echo "H2-JAR nicht gefunden: $JAR"
  exit 1
}
                                ]]></argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2) Das gebaute H2-JAR als target/h2v2.jar kopieren -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>

                <executions>
                    <execution>
                        <id>copy-patched-h2-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy
                                    file="${project.build.directory}/h2-src/h2/bin/h2-${h2.version}.jar"
                                    tofile="${project.build.directory}/h2v2-${h2.version}.jar"
                                    overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3) Jar "shaden" von org.h2 zu org.h2v2 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>

                <executions>
                    <execution>
                        <id>shade-h2v2</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <finalName>h2v2-${h2.version}</finalName>

                            <relocations>
                                <relocation>
                                    <pattern>org.h2</pattern>
                                    <shadedPattern>org.h2v2</shadedPattern>
                                </relocation>
                            </relocations>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
